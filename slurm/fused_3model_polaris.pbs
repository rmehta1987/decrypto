#!/bin/bash
# Polaris (PBS Pro) FUSED multi-node job — all three vLLM servers + the
# Decrypto experiment in ONE 4-node job. Built after the two-job dependent
# pattern proved fragile on the contended `preemptable` queue: server jobs and
# the experiment job queue independently, so servers can burn their entire
# walltime idling before the experiment ever starts (jobs 7197359/7197380/
# 7197381 all died at exactly their walltime with Exit_status=-29), and a
# mid-run server preemption re-registers at a new address the runner (which
# reads URLs once at startup) never sees.
#
# One job = one queue wait, no skew, atomic lifetime — and it fits the
# `capacity` queue (1-4 nodes, <=168 h, NO preemption, 1 running job/user),
# the right home for the 8-16 h production run.
#
# Layout: node 1 -> qwen2.5_72B (TP=4), node 2 -> qwen3_8b, node 3 -> qwen3_4b,
# node 0 (this script's node) -> experiment (CPU/HTTP only, GPUs idle).
# Servers are started on their nodes via `mpiexec --hosts` running
# slurm/start_vllm_server_node.sh (the extracted body of the proven
# server_vllm_polaris.pbs).
#
# Submit (defaults below are smoke-sized; override for production):
#   qsub slurm/fused_3model_polaris.pbs
#   qsub -q preemptable -l walltime=02:00:00 slurm/fused_3model_polaris.pbs
#   qsub -q capacity -l walltime=17:00:00 \
#        -v CONFIG_NAME=local_polaris_3model,EXP_NAME=polaris_3model,SEEDS="0 1 2 3 4" \
#        slurm/fused_3model_polaris.pbs
#
# (PBS reads only lines starting with "#PBS"; annotations go on the line ABOVE.)
#PBS -N decrypto-3model-fused
#PBS -A lighthouse-uchicago
#PBS -q preemptable
#PBS -r y
#PBS -l select=4:ncpus=64:ngpus=4
#PBS -l filesystems=home:eagle
#PBS -l walltime=02:00:00
#PBS -o /lus/eagle/projects/lighthouse-uchicago/members/mehta5/decrypto/logs/paper/
#PBS -e /lus/eagle/projects/lighthouse-uchicago/members/mehta5/decrypto/logs/paper/

set -uo pipefail

BASE=/lus/eagle/projects/lighthouse-uchicago/members/mehta5
REPO_ROOT="$BASE/decrypto"
VENV_TARBALL="${VENV_TARBALL:-$BASE/decrypto-serve-venv.tar}"
CONFIG_NAME="${CONFIG_NAME:-local_polaris_3model}"
EXP_NAME="${EXP_NAME:-polaris_3model}"
SEEDS="${SEEDS:-}"
NUM_EPISODES="${NUM_EPISODES:-}"
# Server bring-up budget (cold 72B load is ~240 s + queueless here, but Lustre
# varies); the experiment-side ready poll gets the same budget.
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-2400}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-2700}"

cd "$REPO_ROOT"
mkdir -p "$REPO_ROOT/logs/paper" "$REPO_ROOT/logs/vllm"

JOBTAG="${PBS_JOBID%%.*}"
WRAP_LOG="$REPO_ROOT/logs/paper/polaris_fused_${JOBTAG}.log"
exec > >(stdbuf -oL -eL tee -a "$WRAP_LOG") 2>&1
echo "=== fused 3-model job $PBS_JOBID on $(hostname) at $(date) ==="

# ── The job's nodes. Node 0 (first in PBS_NODEFILE, where this script runs)
#    hosts the experiment; nodes 1..3 host one server each. ──
mapfile -t NODES < <(sort -u "$PBS_NODEFILE")
echo "nodes: ${NODES[*]}"
if [ "${#NODES[@]}" -lt 4 ]; then echo "FATAL: need 4 nodes, got ${#NODES[@]}"; exit 2; fi

# Per-model serving plan — keep in sync with launch_servers_polaris.sh and the
# verified configs (72B: probe 7197375; Qwen3: probe 7197265).
model_keys=(qwen2.5_72B qwen3_8b qwen3_4b)
model_paths=("$BASE/models/Qwen2.5-72B-Instruct" "$BASE/models/Qwen3-8B" "$BASE/models/Qwen3-4B")
tps=(4 1 1)
mem_utils=(0.97 0.90 0.90)
max_lens=(8192 8192 8192)
mnbts=(2048 "" "")
mnseqs=(64 "" "")
ports=(8101 8102 8103)

SERVERS_DIR="$REPO_ROOT/logs/servers/fused_${JOBTAG}"
mkdir -p "$SERVERS_DIR"
export DECRYPTO_SERVERS_FILE="$SERVERS_DIR"
echo "SERVERS_DIR=$SERVERS_DIR"

MPI_PIDS=()
cleanup() {
    echo "$(date): fused-job cleanup (stopping server launchers)"
    for p in "${MPI_PIDS[@]:-}"; do kill "$p" 2>/dev/null || true; done
}
trap cleanup EXIT TERM INT

# ── Launch one server per node (mpiexec runs the bootstrap on the target
#    node; it stages its own venv and logs to logs/vllm/<key>-<jobtag>.wrap.log) ──
for i in 0 1 2; do
    node="${NODES[$((i+1))]}"
    echo ">>> starting ${model_keys[$i]} on $node (tp=${tps[$i]} port=${ports[$i]})"
    mpiexec -n 1 --ppn 1 --hosts "$node" \
        env VENV_TARBALL="$VENV_TARBALL" \
        bash "$REPO_ROOT/slurm/start_vllm_server_node.sh" \
        "${model_keys[$i]}" "${model_paths[$i]}" "${tps[$i]}" "${ports[$i]}" \
        "$SERVERS_DIR" "${mem_utils[$i]}" "${max_lens[$i]}" "${mnbts[$i]}" \
        "${mnseqs[$i]}" "$HEALTH_TIMEOUT" "$JOBTAG" &
    MPI_PIDS+=($!)
done

# ── Meanwhile prepare the experiment env on THIS node (CPU/HTTP only) ──
module use /soft/modulefiles
module load conda/2025-09-25
conda activate base
unset TMPDIR
NODE_SCRATCH=/local/scratch
[ -d "$NODE_SCRATCH" ] || NODE_SCRATCH=/tmp
export TMPDIR="$NODE_SCRATCH/${USER}_${JOBTAG}"
mkdir -p "$TMPDIR"
if [ ! -f "$VENV_TARBALL" ]; then echo "FATAL: venv tarball not found"; exit 2; fi
LOCAL_VENV="$TMPDIR/decrypto-serve"
mkdir -p "$LOCAL_VENV"
tar xf "$VENV_TARBALL" -C "$LOCAL_VENV"
export VIRTUAL_ENV="$LOCAL_VENV"
export PATH="$LOCAL_VENV/bin:$PATH"
hash -r
export PYTHONPATH="$REPO_ROOT:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
# The runner spawns one process per game (ProcessPoolExecutor with
# max_workers=total games — 405 at 15 seeds); with the default OMP thread
# count (= 64 hw threads) that would blow the per-job cgroup pids.max=4096.
# The experiment is HTTP-only, so 1 BLAS/OMP thread per game process is right.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
# Cap concurrent games so the slow 72B server (KV cache ~18,800 tokens ≈ 2.3x
# concurrency at 8192) is not flooded. Job 7199012 ran all 405 games at once and
# lost ~40% — almost entirely 72B-involving games — to APITimeoutError/503 on
# the overwhelmed 72B server. The 27-game smoke (7197574) completed cleanly, so
# ~24 concurrent is the proven-safe load. Default (unset) = one worker per game.
export DECRYPTO_MAX_WORKERS="${DECRYPTO_MAX_WORKERS:-24}"
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY ftp_proxy FTP_PROXY
export no_proxy="localhost,127.0.0.1,::1,10.201.0.0/16,.hsn.cm.polaris.alcf.anl.gov,.alcf.anl.gov"
export NO_PROXY="$no_proxy"
echo "experiment python: $(command -v python)"

# ── Wait for all 3 servers to answer over HTTP ──
EXPECTED_MODELS=3
echo "Waiting for $EXPECTED_MODELS servers (timeout ${WAIT_TIMEOUT}s)..."
_t0=$SECONDS
while true; do
    READY_COUNT=$(python -m slurm.ping_servers 2>/dev/null | grep -c "Reply time" || true)
    if [ "$READY_COUNT" -ge "$EXPECTED_MODELS" ]; then
        echo "All $EXPECTED_MODELS servers ready after $((SECONDS-_t0))s."
        break
    fi
    # A dead launcher means its server can never come up — fail fast.
    for p in "${MPI_PIDS[@]}"; do
        if ! kill -0 "$p" 2>/dev/null; then
            echo "FATAL: a server launcher exited early; servers dir:"; ls -la "$SERVERS_DIR"
            exit 44
        fi
    done
    if [ $((SECONDS-_t0)) -gt "$WAIT_TIMEOUT" ]; then
        echo "FATAL: only $READY_COUNT/$EXPECTED_MODELS servers ready after ${WAIT_TIMEOUT}s"
        ls -la "$SERVERS_DIR" || true
        exit 46
    fi
    echo "  $READY_COUNT / $EXPECTED_MODELS ready — sleeping 30s..."
    sleep 30
done

# ── Run the experiment ──
SCALE_OVERRIDES=()
[ -n "$SEEDS" ] && SCALE_OVERRIDES+=("env_seed=[${SEEDS// /,}]")
[ -n "$NUM_EPISODES" ] && SCALE_OVERRIDES+=("num_episodes=$NUM_EPISODES")
echo "=== running run.py (config=$CONFIG_NAME exp_name=$EXP_NAME overrides='${SCALE_OVERRIDES[*]:-}') ==="
python run.py \
  --config-path=config/examples \
  --config-name="$CONFIG_NAME" \
  +get_models_from_slurm=true \
  exp_name="$EXP_NAME" \
  "${SCALE_OVERRIDES[@]}"
RUN_RC=$?
echo ">>> run.py exit rc=$RUN_RC"

if [ -f "$REPO_ROOT/results/$EXP_NAME/experiment_summary.csv" ]; then
    echo ">>> RESULTS: results/$EXP_NAME/experiment_summary.csv ($(wc -l < "$REPO_ROOT/results/$EXP_NAME/experiment_summary.csv") lines)"
    [ $RUN_RC -eq 0 ] && echo "=== FUSED RUN COMPLETE at $(date) ==="
else
    echo ">>> WARNING: results/$EXP_NAME/experiment_summary.csv not written"
fi
exit $RUN_RC
